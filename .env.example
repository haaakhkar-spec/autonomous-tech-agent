# ===== الوكيل التقني المستقل — متغيرات البيئة =====
# انسخ هذا الملف إلى .env واملأ القيم.

# ---------- النموذج ----------
# اتركه فارغاً لاستخدام Google Gemini، أو ضع مزوّداً متوافقاً مع OpenAI
# (Groq / OpenRouter / Ollama / vLLM / أي واجهة مفتوحة).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash
LLM_TEMPERATURE=0.35
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=240
LLM_RETRIES=3

# ---------- حدود التنفيذ ----------
# 0 = بلا حد. لا تضع قيماً موجبة إلا إذا أردت سقفاً يدوياً.
MAX_AGENT_STEPS=0
MAX_TOOL_OUTPUT=0
TOOL_RESULT_CHARS=0
TOOL_TIMEOUT=600
HISTORY_TURNS=40
MAX_SEARCH_RESULTS=50
MAX_REPEAT_CALLS=4
MAX_PUBLISH_NUDGES=3

# ---------- كلمة السر ----------
TRIGGER_WORD=نفذ

# ---------- تخطّي الكابتشا (اختياري) ----------
CAPTCHA_API_KEY=

# ---------- الشبكة والنشر ----------
# PUBLIC_BASE_URL يُضبط تلقائياً على Render عبر RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=
HOST=0.0.0.0
PORT=8000

# ---------- البيانات ----------
# على Render اربطه بالقرص الدائم: /var/data
DATA_DIR=./data
